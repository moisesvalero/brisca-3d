{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brisca-3d-ws",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/health"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BRISCA",
        "class_name": "BriscaRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BriscaRoom"]
    }
  ]
}
