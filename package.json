{
  "name": "brisca-3d-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Moisés Valero Sánchez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moisesvalero/brisca-3d.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @brisca/server --filter @brisca/client --parallel dev",
    "dev:worker": "pnpm --filter @brisca/worker dev:worker",
    "deploy:worker": "pnpm --filter @brisca/client build && pnpm --filter @brisca/worker run deploy",
    "deploy:web": "pnpm dlx vercel@latest --prod --yes",
    "release": "pnpm run deploy:worker && pnpm run deploy:web",
    "build": "pnpm --filter \"@brisca/*\" build",
    "test": "pnpm -r --if-present test",
    "check": "pnpm -r --if-present typecheck",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^0.15.11",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
